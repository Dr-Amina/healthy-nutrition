/* =========================
RESET
========================= */

* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {
background: #f3f0e9;
color: #1d1d1b;
font-family: Arial, Helvetica, sans-serif;
overflow-x: hidden;
}

img {
display: block;
width: 100%;
}

a {
color: inherit;
text-decoration: none;
}

button {
font: inherit;
}


/* =========================
HEADER
========================= */

.header {
position: absolute;
top: 0;
left: 0;

width: 100%;
height: 72px;

padding: 0 20px;

display: flex;
align-items: center;
justify-content: space-between;

z-index: 10;

color: #fff;
}

.logo {
font-size: 14px;
font-weight: 600;
letter-spacing: 0.18em;
}

.navigation {
display: none;
}

.menu-button {
width: 38px;
height: 38px;

border: 1px solid rgba(255,255,255,0.65);
border-radius: 50%;

background: transparent;

display: flex;
flex-direction: column;
justify-content: center;
align-items: center;
gap: 5px;
}

.menu-button span {
width: 12px;
height: 1px;
background: #fff;
}


/* =========================
HERO
========================= */

.hero {
position: relative;
min-height: 100svh;

display: flex;
align-items: flex-end;

overflow: hidden;

background: #222;
}

.hero-image {
position: absolute;
inset: 0;

width: 100%;
height: 100%;

object-fit: cover;
}

.hero-overlay {
position: absolute;
inset: 0;

background: linear-gradient(
to top,
rgba(0,0,0,0.58),
rgba(0,0,0,0.08) 65%
);
}

.hero-content {
position: relative;

width: 100%;

padding: 0 20px 46px;

color: #fff;
}

.eyebrow,
.small-title {
font-size: 10px;
letter-spacing: 0.18em;
text-transform: uppercase;
}

.hero h1 {
margin-top: 14px;

font-size: clamp(48px, 15vw, 78px);
line-height: 0.92;
font-weight: 400;
letter-spacing: -0.045em;
}

.hero-description {
max-width: 310px;

margin-top: 25px;

font-size: 14px;
line-height: 1.5;
}

.hero-link {
display: flex;
justify-content: space-between;
align-items: center;

margin-top: 35px;

padding-top: 14px;

border-top: 1px solid rgba(255,255,255,0.55);

font-size: 11px;
letter-spacing: 0.08em;
text-transform: uppercase;
}

.hero-link span {
font-size: 17px;
}


/* =========================
GENERAL SECTIONS
========================= */

.section {
padding: 90px 20px;
}

.section-number {
margin-bottom: 45px;

font-size: 10px;
letter-spacing: 0.15em;
}

.section-content {
max-width: 550px;
}

.small-title {
margin-bottom: 25px;
color: #77736b;
}

.section h2,
.food-heading h2,
.faq-header h2 {
font-size: clamp(42px, 12vw, 70px);
line-height: 0.95;
font-weight: 400;
letter-spacing: -0.05em;
}

.text {
max-width: 390px;

margin-top: 35px;

font-size: 15px;
line-height: 1.65;
color: #57534c;
}


/* =========================
FOOD
========================= */

.food-section {
padding: 30px 20px 100px;
}

.food-heading {
margin-bottom: 55px;
}

.food-grid {
display: flex;
flex-direction: column;
gap: 70px;
}

.food-card {
border-top: 1px solid #bbb6ac;
}

.food-image {
aspect-ratio: 3 / 4;
overflow: hidden;
}

.food-image img {
width: 100%;
height: 100%;
object-fit: cover;
}

.food-info {
padding-top: 15px;

display: grid;
grid-template-columns: 35px 1fr;
column-gap: 10px;
}

.food-info span {
font-size: 10px;
color: #77736b;
}

.food-info h3 {
font-size: 24px;
font-weight: 400;
letter-spacing: -0.02em;
}

.food-info p {
grid-column: 2;

max-width: 270px;

margin-top: 12px;

font-size: 13px;
line-height: 1.5;
color: #67635b;
}


/* =========================
PROGRAM
========================= */

.program {
border-top: 1px solid #c5c0b6;
}


/* =========================
FAQ
========================= */

.faq {
padding: 90px 20px 110px;

border-top: 1px solid #c5c0b6;
}

.faq-header {
margin-bottom: 55px;
}

.accordion {
border-top: 1px solid #aaa59b;
}

.accordion-item {
border-bottom: 1px solid #aaa59b;
}

.accordion-button {
width: 100%;

padding: 22px 0;

border: 0;
background: transparent;

display: flex;
justify-content: space-between;
align-items: center;

text-align: left;

cursor: pointer;

font-size: 15px;
}

.accordion-icon {
font-size: 23px;
font-weight: 300;

transition: transform 0.3s ease;
}

.accordion-item.active .accordion-icon {
transform: rotate(45deg);
}

.accordion-content {
max-height: 0;

overflow: hidden;

transition:
max-height 0.45s ease,
padding 0.45s ease;
}

.accordion-content p {
max-width: 520px;

padding-bottom: 0;

color: #68645d;

font-size: 14px;
line-height: 1.65;
}

.accordion-item.active .accordion-content {
max-height: 300px;
}

.accordion-item.active .accordion-content p {
padding-bottom: 25px;
}


/* =========================
FINAL IMAGE
========================= */

.final-section {
position: relative;

height: 75svh;

overflow: hidden;
}

.final-section img {
width: 100%;
height: 100%;

object-fit: cover;
}

.final-overlay {
position: absolute;
inset: 0;

background: rgba(0,0,0,0.3);
}

.final-content {
position: absolute;
left: 20px;
bottom: 40px;

color: #fff;
}

.final-content h2 {
margin-top: 15px;

font-size: clamp(45px, 13vw, 75px);
line-height: 0.92;
font-weight: 400;
letter-spacing: -0.05em;
}


/* =========================
FOOTER
========================= */

.footer {
min-height: 130px;

padding: 25px 20px;

display: flex;
justify-content: space-between;
align-items: flex-end;

background: #1d1d1b;
color: #f3f0e9;
}

.footer-logo {
font-size: 13px;
letter-spacing: 0.18em;
}

.footer-right {
font-size: 10px;
color: #aaa69d;
}


/* =========================
TABLET
========================= */

@media (min-width: 700px) {

.header {
padding: 0 40px;
}

.navigation {
display: flex;
gap: 30px;

font-size: 11px;
text-transform: uppercase;
letter-spacing: 0.08em;
}

.menu-button {
display: none;
}

.hero-content {
padding: 0 40px 60px;
}

.hero-description {
max-width: 360px;
}

.section,
.faq {
padding-left: 40px;
padding-right: 40px;
}

.food-section {
padding-left: 40px;
padding-right: 40px;
}

.food-grid {
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 60px 30px;
}

.food-card:last-child {
grid-column: 1 / -1;
max-width: 50%;
}

.final-content {
left: 40px;
bottom: 60px;
}

.footer {
padding: 30px 40px;
}
}


/* =========================
DESKTOP
========================= */

@media (min-width: 1100px) {

.header {
height: 90px;
padding: 0 60px;
}

.hero-content {
padding: 0 60px 70px;
}

.hero h1 {
font-size: 100px;
}

.hero-description {
font-size: 15px;
}

.section {
min-height: 80vh;

padding: 140px 60px;

display: grid;
grid-template-columns: 100px 1fr;
}

.section-number {
margin: 0;
}

.food-section {
padding: 100px 60px 150px;
}

.food-heading {
margin-bottom: 90px;
}

.food-grid {
grid-template-columns: repeat(3, 1fr);
gap: 35px;
}

.food-card:last-child {
grid-column: auto;
max-width: none;
}

.food-image {
aspect-ratio: 4 / 5;
}

.faq {
padding: 140px 60px;
display: grid;
grid-template-columns: 1fr 1.2fr;
gap: 100px;
}

.faq-header {
margin: 0;
}

.final-section {
height: 90vh;
}

.final-content {
left: 60px;
bottom: 70px;
}

.footer {
min-height: 160px;
padding: 35px 60px;
}
}






document.addEventListener("DOMContentLoaded", () => {

const accordionItems = document.querySelectorAll(".accordion-item");

accordionItems.forEach((item) => {

const button = item.querySelector(".accordion-button");
const content = item.querySelector(".accordion-content");

button.addEventListener("click", () => {

const isActive = item.classList.contains("active");

// Закрываем все остальные пункты
accordionItems.forEach((otherItem) => {

otherItem.classList.remove("active");

const otherContent =
otherItem.querySelector(".accordion-content");

otherContent.style.maxHeight = null;

});


// Если нажатый пункт был закрыт — открываем его
if (!isActive) {

item.classList.add("active");

content.style.maxHeight =
content.scrollHeight + "px";

}

});

});


// Плавный переход по внутренним ссылкам

const links = document.querySelectorAll('a[href^="#"]');

links.forEach((link) => {

link.addEventListener("click", (event) => {

const targetId = link.getAttribute("href");

if (targetId === "#") {
return;
}

const target = document.querySelector(targetId);

if (target) {

event.preventDefault();

target.scrollIntoView({
behavior: "smooth",
block: "start"
});

}

});

});

});
